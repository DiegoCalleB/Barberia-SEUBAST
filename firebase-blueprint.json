{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User profile information including subscription status and role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "subscription": {
          "type": "object",
          "properties": {
            "plan": { "type": "string", "enum": ["standard", "premium", "none"] },
            "expiresAt": { "type": "string", "format": "date-time" }
          }
        }
      },
      "required": ["uid", "email", "role"]
    },
    "service": {
      "title": "Barber Service",
      "description": "A service offered by the barbershop.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "duration": { "type": "number", "description": "Duration in minutes" },
        "category": { "type": "string", "enum": ["hair", "beard", "treatment"] }
      },
      "required": ["name", "price", "duration", "category"]
    },
    "product": {
      "title": "Boutique Product",
      "description": "A product available in the online store.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string", "format": "uri" },
        "category": { "type": "string" },
        "stock": { "type": "integer" }
      },
      "required": ["name", "price", "image"]
    },
    "appointment": {
      "title": "Booking Appointment",
      "description": "A scheduled appointment for a service.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User UID who booked" },
        "serviceId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "notes": { "type": "string" }
      },
      "required": ["uid", "serviceId", "date", "status"]
    },
    "saved_look": {
      "title": "Saved AI Look",
      "description": "A look generated by the AI Stylist that the user has saved.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "styleId": { "type": "string" },
        "styleName": { "type": "string" },
        "category": { "type": "string" },
        "originalImage": { "type": "string" },
        "generatedImage": { "type": "string" },
        "perspective": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "styleId", "styleName", "category", "originalImage", "generatedImage", "perspective", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "/services/{serviceId}": {
      "schema": "service",
      "description": "Available barber services"
    },
    "/products/{productId}": {
      "schema": "product",
      "description": "Boutique products"
    },
    "/appointments/{appointmentId}": {
      "schema": "appointment",
      "description": "Booked appointments"
    },
    "/saved_looks/{lookId}": {
      "schema": "saved_look",
      "description": "AI Stylist saved looks"
    }
  }
}
