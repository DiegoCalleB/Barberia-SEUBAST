rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - photoURL: string (optional)
    //   - role: string (required, 'admin' or 'client')
    //   - subscription: map (optional)
    //
    // Collection: services
    // Document ID: {serviceId}
    // Fields:
    //   - name: string (required)
    //   - description: string (optional)
    //   - price: number (required)
    //   - duration: number (required)
    //   - category: string (required)
    //
    // Collection: products
    // Document ID: {productId}
    // Fields:
    //   - name: string (required)
    //   - price: number (required)
    //   - image: string (required)
    //   - description: string (optional)
    //   - category: string (optional)
    //   - stock: number (optional)
    //
    // Collection: appointments
    // Document ID: {appointmentId}
    // Fields:
    //   - uid: string (required)
    //   - serviceId: string (required)
    //   - date: timestamp (required)
    //   - status: string (required)
    //   - notes: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "diego.delacalleb@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'client'];
    }

    function isValidService(data) {
      return data.keys().hasAll(['name', 'price', 'duration', 'category']) &&
             data.name is string && data.name.size() > 0 &&
             data.price is number && data.price >= 0 &&
             data.duration is number && data.duration > 0;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'image']) &&
             data.name is string && data.name.size() > 0 &&
             data.price is number && data.price >= 0 &&
             data.image is string;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['uid', 'serviceId', 'date', 'status']) &&
             data.uid == request.auth.uid &&
             data.serviceId is string &&
             data.date is timestamp &&
             data.status in ['pending', 'confirmed', 'cancelled'];
    }

    function isValidSavedLook(data) {
      return data.keys().hasAll(['uid', 'styleId', 'styleName', 'category', 'originalImage', 'generatedImage', 'perspective', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.styleId is string &&
             data.styleName is string &&
             data.category is string &&
             data.originalImage is string &&
             data.generatedImage is string &&
             data.perspective is string &&
             data.createdAt == request.time;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == 'client';
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() && isValidService(request.resource.data);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidProduct(request.resource.data);
    }

    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidAppointment(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) && isValidAppointment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /saved_looks/{lookId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidSavedLook(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
